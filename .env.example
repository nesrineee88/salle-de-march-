# Copier ce fichier en « .env » (jamais versionné) et remplacer les valeurs.
POSTGRES_USER=simulateur
POSTGRES_PASSWORD=choisir-un-vrai-mot-de-passe
POSTGRES_DB=simulateur
POSTGRES_PORT=5432

# Côté API (backend) :
SDM_DATABASE_URL=postgresql+psycopg://simulateur:choisir-un-vrai-mot-de-passe@127.0.0.1:5432/simulateur
SDM_ENV=production
SDM_JWT_SECRET=générer-avec-python-c-"import secrets;print(secrets.token_urlsafe(48))"
